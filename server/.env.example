NODE_ENV=production
HOST=0.0.0.0
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Production example:
# CLIENT_ORIGIN=https://quitech.online,https://www.quitech.online
# SESSION_COOKIE_DOMAIN=.quitech.online
# SESSION_COOKIE_SAMESITE=None
DATABASE_URL=postgresql://quiz_user:change-me@127.0.0.1:5432/quiz_master
# Set PGSSL=true when your VPS PostgreSQL requires TLS.
PGSSL=false

# Google Sign-In: comma-separated Web OAuth client IDs accepted by the API.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
PUBLIC_APP_URL=https://quitech.online

# Transactional email through the quitechug@gmail.com Google app password.
# Port 465 uses SMTP_SECURE=true; port 587 uses false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=quitechug@gmail.com
SMTP_PASS=replace-with-google-app-password
SMTP_FROM=Quitech <quitechug@gmail.com>
SUPPORT_EMAIL=quitechug@gmail.com

# Firebase Admin service-account JSON on one line. Used only by the API server.
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-time admin creation. Keep the real password out of Git.
ADMIN_EMAIL=saptechug@gmail.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Saptech Admin
